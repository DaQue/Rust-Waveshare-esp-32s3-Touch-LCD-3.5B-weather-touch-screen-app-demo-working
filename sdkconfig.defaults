# Main task stack — 32K needed for NVS init deep call chain.
# Render thread owns drawing; main loop is lightweight.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Partition table with NVS keys partition for encrypted NVS.
CONFIG_PARTITION_TABLE_SINGLE_APP_ENCRYPTED_NVS=y

# USB Serial/JTAG console (ESP32-S3 native USB)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# stdin: convert CR to LF so read_line() works with terminal Enter key
CONFIG_NEWLIB_STDIN_LINE_ENDING_CR=y
# Keep XPowers on legacy I2C API to avoid mixed old/new driver conflict.
CONFIG_XPOWERS_ESP_IDF_OLD_API=y
# CONFIG_XPOWERS_ESP_IDF_NEW_API is not set

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# HTTPS / TLS (for OpenWeatherMap API)
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=16384
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
# Route all mbedTLS heap allocations (SSL context, cert chain, key buffers,
# handshake scratch) to PSRAM instead of internal SRAM.  Requires
# SPIRAM_USE_CAPS_ALLOC=y.  Failed TLS handshakes still fragment memory, but
# PSRAM has 8MB to absorb it — internal SRAM is left clean for the OS/tasks.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Dynamic TX/RX buffers: size to the current TLS record instead of a static
# 16KB in/out pair.  Cuts peak allocation per handshake by ~12KB.
# NOTE: incompatible with TLS 1.3 (IDF-4762) — we use TLS 1.2 only.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Free private key + DHM data immediately after handshake.
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# Free CA cert immediately after handshake.  Safe because every request
# creates a fresh EspHttpConnection — sessions are never reused.
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
# Disable hardware AES/SHA/MPI acceleration.
# The ESP32-S3 hardware crypto engines work via GDMA which can only access
# internal SRAM — they call heap_caps_malloc(MALLOC_CAP_DMA) directly,
# bypassing MBEDTLS_EXTERNAL_MEM_ALLOC entirely.  These variable-sized DMA
# buffers (input/output chunks + descriptor lists) are the real source of
# internal SRAM fragmentation.  Software mbedTLS uses the PSRAM allocator
# for all operations — no internal SRAM is touched during TLS handshakes.
# Performance cost: ~1-3s longer handshake.  Acceptable: requests run no
# faster than every 30s and the HTTP timeout is 15s.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_MPI=n

# NTP
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# NVS encryption
CONFIG_NVS_ENCRYPTION=y
# ESP-IDF 5.2.x default can resolve to an invalid HMAC key id (6) on ESP32-S3.
# Pin to valid eFuse key id range [0..5].
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5

# PSRAM allocation threshold: allocations larger than this go to PSRAM
# automatically instead of SRAM.  Prevents serde_json intermediate Strings
# and AppState Vec<ForecastRow>/Vec<HourlyEntry> from fragmenting SRAM.
# Thread stacks use MALLOC_CAP_INTERNAL explicitly so they ignore this.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256

# Pthread stack defaults (for spawned threads)
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# Task watchdog timeout: default 5s is too short when two back-to-back TLS
# handshakes run (current weather + forecast).  Software mbedTLS (no HW accel)
# takes 1-3s per handshake, so IDLE1 can be starved for >5s on CPU 1.
# 30s matches the minimum fetch interval and still catches real deadlocks.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
